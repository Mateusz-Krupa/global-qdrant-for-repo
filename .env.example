# Copy to .env and fill in. The server loads this file on startup.

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Any OpenAI-compatible /v1 endpoint
EMBEDDER_URL=https://your-endpoint/v1
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=inference-bge-m3
EMBEDDER_API_KEY=sk-...
EMBEDDER_DIMENSIONS=1024        # must match the model (bge-m3 = 1024)
EMBEDDER_BATCH_SIZE=50

# Optional reranker — set RERANKER_PROVIDER=none to disable
RERANKER_URL=https://your-endpoint/v1
RERANKER_PROVIDER=maas
RERANKER_MODEL=inference-bge-reranker
RERANKER_API_KEY=sk-...
